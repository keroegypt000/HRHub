{
  "name": "hrhub-desktop",
  "productName": "HRHub",
  "version": "1.0.27",
  "description": "ADAMAS — HR, attendance and payroll",
  "author": "HRHub",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "38.8.4",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.hrhub.desktop",
    "productName": "HRHub",
    "copyright": "© 2026 ADAMAS. All rights reserved.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "splash.html",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "app",
        "to": "app-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ADAMAS",
      "artifactName": "ADAMAS-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE.txt",
      "uninstallDisplayName": "ADAMAS"
    }
  }
}
