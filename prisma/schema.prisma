// ADMS FOR HR MANAGMENT — نظام إدارة الموارد البشرية والحضور والرواتب
// Prisma Schema (PostgreSQL / Prisma Postgres) — 26 جدولًا
// للتشغيل المحلي القديم على SQLite استخدم prisma/schema-sqlite.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== المصادقة والنظام =====
model User {
  id           String         @id @default(cuid())
  username     String         @unique
  name         String
  passwordHash String
  salt         String
  role         String         @default("viewer") // admin|hr|accountant|supervisor|viewer
  permissions  String? // JSON صلاحيات دقيقة تتجاوز افتراضي الدور
  email        String? // لإشعارات الموافقات
  employeeId   String?        @unique // حساب بوابة الموظف (role=employee) مرتبط بملفه
  employee     Employee?      @relation("UserEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]
  restores     RestorePoint[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String // create|update|delete|login|sync|import|approve|pay
  entity      String
  entityId    String?
  changes     String? // JSON before/after
  description String // وصف عربي تلقائي
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model RestorePoint {
  id          String   @id @default(cuid())
  userId      String?
  description String
  snapshot    String // JSON لقطة للأقسام الأساسية
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
}

model FileUpload {
  id         String    @id @default(cuid())
  fileName   String
  mimeType   String
  size       Int
  data       Bytes? // وضع احتياطي داخل القاعدة
  r2Key      String? // مفتاح Cloudflare R2 (للاستخدام المستقبلي عند توفر بيانات الاعتماد)
  ownerTag   String? // employee_photo|contract_file|leave_attachment
  employeeId String?
  createdAt  DateTime  @default(now())
  createdBy  String?
  employee   Employee? @relation("EmpFiles", fields: [employeeId], references: [id])
  empPhoto   Employee? @relation("EmpPhoto")
}

model ImportLog {
  id          String   @id @default(cuid())
  entity      String
  fileName    String
  totalRows   Int
  successRows Int
  failedRows  Int
  errors      String? // JSON أخطاء كل صف
  createdBy   String?
  createdAt   DateTime @default(now())
}

// ===== الهيكل التنظيمي والموظفون والعقود =====
model Department {
  id        String       @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  parentId  String?
  parent    Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children  Department[] @relation("DeptTree")
  employees Employee[]
}

model Position {
  id        String     @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
}

model Employee {
  id               String                @id @default(cuid())
  code             String                @unique // الرقم الوظيفي = pin الجهاز افتراضيًا
  name             String
  photoId          String?               @unique
  gender           String?
  nationality      String?
  civilId          String?               @unique // الرقم المدني
  passportNo       String?
  phone            String?
  email            String?
  address          String?
  birthDate        DateTime?
  maritalStatus    String?
  departmentId     String?
  positionId       String?
  hireDate         DateTime?
  basicSalary      Float                 @default(0) // د.ك ثلاث خانات عشرية
  bankAccount      String?
  status           String                @default("active") // active|suspended|on_leave|terminated|deceased
  departureDate    DateTime? // تاريخ ترك العمل / الوفاة
  departureReason  String? // resigned|terminated|retired|deceased|contract_end
  deathDate        DateTime? // تاريخ الوفاة (صفحة المتوفين)
  pin              String? // معرف البصمة داخل الأجهزة
  managerId        String? // المدير المباشر
  weeklyOffDays    String? // JSON أيام الراحة الأسبوعية للموظف [0=الأحد..6=السبت] — يتقدم على وردية الموظف
  eosBasis         String? // أساس مكافأة نهاية الخدمة: basic=الأساسي فقط | full_wage=الأساسي+البدلات | فارغ=افتراضي الشركة
  otEligible       Boolean               @default(false) // يستحق العمل الإضافي — لا يُصرف إضافي إلا بموافقة صريحة
  attendanceExempt Boolean               @default(false) // معفى من البصمة (مدير/مندوب) — راتب كامل بلا خصم غياب أو تأخير
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  department       Department?           @relation(fields: [departmentId], references: [id])
  position         Position?             @relation(fields: [positionId], references: [id])
  photo            FileUpload?           @relation("EmpPhoto", fields: [photoId], references: [id])
  manager          Employee?             @relation("MgrTree", fields: [managerId], references: [id])
  directReports    Employee[]            @relation("MgrTree")
  contracts        Contract[]
  attendanceLogs   AttendanceLog[]
  dailyAttendance  DailyAttendance[]
  shiftAssignments ShiftAssignment[]
  leaveRequests    LeaveRequest[]
  payslips         Payslip[]
  files            FileUpload[]          @relation("EmpFiles")
  passports        Passport[]
  iqamas           Iqama[]
  settlements      DepartureSettlement[]
  loans            Loan[]
  requests         EmployeeRequest[]
  userAccount      User?                 @relation("UserEmployee")

  @@index([name])
  @@index([status])
}

model Contract {
  id                 String     @id @default(cuid())
  employeeId         String
  contractNo         String     @unique
  type               String     @default("full_time") // full_time|part_time|temporary|consultant
  startDate          DateTime
  endDate            DateTime?
  durationMonths     Int?
  basicSalary        Float
  housingAllowance   Float      @default(0)
  transportAllowance Float      @default(0)
  otherAllowance     Float      @default(0)
  hoursPerDay        Float      @default(8)
  daysPerWeek        Int        @default(5)
  status             String     @default("active") // active|expired|terminated|renewed
  renewalOfId        String?
  terminatedAt       DateTime?
  terminationReason  String?
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  employee           Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  renewalOf          Contract?  @relation("Renewals", fields: [renewalOfId], references: [id])
  renewals           Contract[] @relation("Renewals")
}

// ===== التنبيهات: الجوازات والسيارات وعقود الشركة ونهاية الخدمة =====
model Passport {
  id          String    @id @default(cuid())
  employeeId  String?
  holderName  String // اسم صاحب الجواز
  passportNo  String
  nationality String?
  issueDate   DateTime?
  expiryDate  DateTime
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    Employee? @relation(fields: [employeeId], references: [id])

  @@index([expiryDate])
}

model Iqama {
  id          String    @id @default(cuid())
  employeeId  String?
  holderName  String // اسم صاحب الإقامة
  iqamaNo     String // رقم الإقامة
  nationality String?
  profession  String? // المهنة المكتوبة في الإقامة
  issueDate   DateTime?
  expiryDate  DateTime
  sponsor     String? // الكفيل
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    Employee? @relation(fields: [employeeId], references: [id])

  @@index([expiryDate])
}

model Vehicle {
  id               String    @id @default(cuid())
  plateNo          String    @unique
  make             String? // الماركة
  model            String? // الموديل
  year             Int?
  color            String?
  driverName       String? // السائق المسؤول
  licenseExpiry    DateTime? // رخصة السير
  insuranceExpiry  DateTime? // وثيقة التأمين
  inspectionExpiry DateTime? // الفحص الدوري
  insuranceCompany String?
  policyNo         String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model CompanyContract {
  id           String    @id @default(cuid())
  name         String // اسم/وصف العقد
  counterparty String? // الطرف الآخر
  contractNo   String?
  type         String? // توريد|خدمات|إيجار|صيانة...
  value        Float? // قيمة العقد
  startDate    DateTime?
  endDate      DateTime
  renewal      Boolean   @default(true) // قابل للتجديد
  status       String    @default("active") // active|expired|terminated
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([endDate])
}

// تسوية نهاية الخدمة والمستحقات — واحدة لكل موظف عند ترك العمل أو الوفاة
// نموذج مطابق لتقارير MenaITech: كشف مرتب + تعويض إجازات + مكافأة بشرائح + مستحقات أخرى
model DepartureSettlement {
  id              String    @id @default(cuid())
  employeeId      String    @unique
  departureDate   DateTime
  reason          String // resigned|terminated|retired|deceased|contract_end
  hireDate        DateTime?
  lastWage        Float     @default(0) // آخر أجر شهري (أساسي + بدلات منتظمة)
  eosBasis        String? // أساس المكافأة المستخدم: basic|full_wage
  yearsServed     Float     @default(0)
  indemnityFull   Float     @default(0) // المكافأة كاملة قبل معامل السبب
  reasonFactor    Float     @default(1) // معامل القانون حسب السبب (نسبة فترة الخدمة للاستقالة)
  eosAmount       Float     @default(0) // مكافأة نهاية الخدمة المستحقة
  leaveAllowance  Float     @default(0) // بدل الإجازات غير المستخدمة (قيمة)
  vacationDays    Float     @default(0) // أيام الإجازات غير المستخدمة (تعويض الإجازات)
  otherDues       Float     @default(0) // مستحقات أخرى
  deductions      Float     @default(0) // استقطاعات
  totalDue        Float     @default(0)
  paidAmount      Float     @default(0)
  status          String    @default("pending") // pending|partial|paid
  paidAt          DateTime?
  notes           String?
  // ===== تفصيل راتب المكافأة (STB Salary Breakdown) =====
  stbHousing      Float     @default(0) // بدل سكن
  stbSocial       Float     @default(0) // بدل اجتماعي
  stbProvident    Float     @default(0) // صندوق ائتمان/معاش
  stbInsurance    Float     @default(0) // تأمين
  // ===== كشف المرتب داخل التسوية =====
  daysPaid        Float     @default(0) // أيام مدفوعة (شهر التسوية حتى تاريخها)
  worthSalary     Float     @default(0) // قيمة راتب الفترة (Worth Salary)
  loanDeduction   Float     @default(0) // أقساط قروض غير مسددة
  // ===== تفاصيل الحساب المخزنة =====
  slices          String? // JSON شرائح المكافأة: from|to|workingDays|stbDays|percent|amount
  otherDuesDetail String? // JSON مستحقات أخرى مفصلة (أثاث/فرق رواتب/...)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ===== السلف والقروض — تُخصم أقساطها من الرواتب وتظهر في التسوية =====
model Loan {
  id                String   @id @default(cuid())
  employeeId        String
  name              String // وصف السلفة/القرض
  totalAmount       Float
  installmentsCount Int
  monthlyDeduction  Float
  startDate         DateTime // بداية الخصم
  paidInstallments  Int      @default(0)
  paidAmount        Float    @default(0)
  status            String   @default("active") // active|completed|cancelled
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
}

// ===== إعدادات سلسلة الموافقات — لكل وحدة × نوع طلب حتى 4 مستويات =====
model WorkflowConfig {
  id           String   @id @default(cuid())
  unitKey      String   @default("ALL") // معرف الوحدة: اسم القسم أو ALL لكل الوحدات
  departmentId String? // ربط اختياري بقسم من الشجرة
  requestType  String // vacation|loan|salary_certificate|salary_continuity|uniform|it_device|stationary|business_card|equipment
  level1UserId String?
  level2UserId String?
  level3UserId String?
  level4UserId String?
  notifyEmail  String? // إيميل مستلم إشعار الاعتماد/الرفض
  updatedAt    DateTime @updatedAt

  @@unique([unitKey, requestType])
}

// ===== طلبات الموظفين العامة (إجازة/سلفة/شهادات/بذلة/أجهزة/أدوات...) بسلسلة موافقات =====
model EmployeeRequest {
  id          String    @id @default(cuid())
  employeeId  String
  type        String // vacation|loan|salary_certificate|salary_continuity|uniform|it_device|stationary|business_card|equipment
  unitKey     String? // وحدة الموظف وقت الطلب (اسم القسم)
  payload     String? // JSON حسب النوع: أيام/مبلغ/وصف/غرض...
  status      String    @default("pending") // pending|approved|rejected|cancelled
  steps       String // JSON سلسلة الموافقات: [{userId, name, status, comment, at}]
  currentStep Int       @default(0) // مؤشر المستوى الحالي (0-بقيد الانتظار على الأول)
  decidedAt   DateTime?
  loanId      String? // لو طلب سلفة اعتُمد → يُنشأ قرض مرتبط
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([employeeId])
}

// ===== الأجهزة والبصمة والورديات =====
model Device {
  id             String          @id @default(cuid())
  sn             String          @unique // الرقم التسلسلي للجهاز
  name           String
  model          String?
  location       String?
  ipAddress      String?
  port           Int?
  mode           String          @default("push") // push=ADMS أونلاين | local=محلي سحب عبر منفذ 4370
  commKey        String? // مفتاح الاتصال للوضع المحلي (إن عُدّل من الجهاز)
  lastSeenAt     DateTime?
  lastIp         String?
  lastPullAt     DateTime? // آخر سحب ناجح للسجلات من جهاز محلي
  status         String          @default("unknown") // online|offline|unknown
  enabled        Boolean         @default(true)
  pushVersion    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attendanceLogs AttendanceLog[]
}

model AttendanceLog {
  id         String    @id @default(cuid())
  sn         String
  pin        String // معرف المستخدم داخل الجهاز
  employeeId String?
  punchTime  DateTime
  status     Int       @default(0) // 0 دخول|1 خروج|2 خروج استراحة|3 عودة|4 دخول إضافي|5 خروج إضافي
  verify     Int       @default(1) // 1 بصمة|3 كلمة سر|4 بطاقة|15 وجه
  workCode   String?
  source     String    @default("adms") // adms|biotime|excel|manual
  createdAt  DateTime  @default(now())
  device     Device    @relation(fields: [sn], references: [sn], onDelete: Cascade)
  employee   Employee? @relation(fields: [employeeId], references: [id])

  @@unique([sn, pin, punchTime, status])
  @@index([punchTime])
  @@index([employeeId])
}

model Shift {
  id                String            @id @default(cuid())
  name              String
  type              String            @default("fixed") // fixed|flexible|auto
  startTime         String // "08:00"
  endTime           String // "17:00"
  crossDay          Boolean           @default(false) // وردية ليلية تعبر منتصف الليل
  graceMinutes      Int               @default(10)
  earlyGraceMinutes Int               @default(10)
  otEnabled         Boolean           @default(true)
  otRoundMinutes    Int               @default(15)
  halfDayMinutes    Int               @default(240)
  workDays          String            @default("[0,1,2,3,4]") // 0=الأحد
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  assignments       ShiftAssignment[]
  dailyAttendance   DailyAttendance[]
}

model ShiftAssignment {
  id         String    @id @default(cuid())
  employeeId String
  shiftId    String
  fromDate   DateTime
  toDate     DateTime?
  createdAt  DateTime  @default(now())
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift      Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([employeeId, fromDate])
}

model DailyAttendance {
  id            String    @id @default(cuid())
  employeeId    String
  date          DateTime
  shiftId       String?
  firstIn       DateTime?
  lastOut       DateTime?
  workedMinutes Int       @default(0)
  lateMinutes   Int       @default(0)
  earlyMinutes  Int       @default(0)
  otMinutes     Int       @default(0)
  status        String    @default("absent") // present|late|half_day|absent|leave|holiday|weekend|missed_punch
  note          String?
  processedAt   DateTime  @default(now())
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift         Shift?    @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
}

// ===== الإجازات والعطلات =====
model LeaveType {
  id        String         @id @default(cuid())
  name      String
  code      String         @unique
  paid      Boolean        @default(true)
  quotaDays Float?
  color     String?
  active    Boolean        @default(true)
  requests  LeaveRequest[]
}

model LeaveRequest {
  id          String    @id @default(cuid())
  employeeId  String
  leaveTypeId String
  fromDate    DateTime
  toDate      DateTime
  days        Float
  reason      String?
  status      String    @default("pending") // pending|approved|rejected|cancelled
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([fromDate])
}

model Holiday {
  id        String    @id @default(cuid())
  name      String
  date      DateTime
  endDate   DateTime? // نطاق عطلة (مثل عيد الفطر)
  recurring Boolean   @default(false)
  createdAt DateTime  @default(now())
}

// ===== الرواتب =====
model SalaryComponent {
  id             String        @id @default(cuid())
  name           String
  code           String        @unique
  type           String // earning|deduction
  calculation    String        @default("fixed") // fixed|attendance|percent|manual
  value          Float         @default(0)
  percentOfBasic Float?
  active         Boolean       @default(true)
  order          Int           @default(0)
  items          PayslipItem[]
}

model PayrollPeriod {
  id         String    @id @default(cuid())
  name       String    @unique // "2026-01"
  startDate  DateTime
  endDate    DateTime
  status     String    @default("draft") // draft|computed|approved|paid
  computedAt DateTime?
  approvedBy String?
  approvedAt DateTime?
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  payslips   Payslip[]
}

model Payslip {
  id               String        @id @default(cuid())
  periodId         String
  employeeId       String
  basicSalary      Float
  totalEarnings    Float
  totalDeductions  Float
  netPay           Float
  workedDays       Float         @default(0)
  absenceDays      Float         @default(0)
  paidLeaveDays    Float         @default(0) // أيام إجازات معتمدة مدفوعة
  unpaidLeaveDays  Float         @default(0) // أيام إجازات معتمدة غير مدفوعة
  holidayDays      Int           @default(0) // أيام عطلات رسمية داخل الفترة
  weekOffDays      Int           @default(0) // أيام راحة أسبوعية داخل الفترة
  dayLedger        String? // JSON حالة كل يوم: p حاضر a غائب lp إجازة مدفوعة lu غير مدفوعة ho عطلة we راحة m بصمة ناقصة
  otHours          Float         @default(0)
  otAmount         Float         @default(0)
  lateMinutes      Int           @default(0)
  lateDeduction    Float         @default(0)
  absenceDeduction Float         @default(0)
  status           String        @default("draft")
  notes            String?
  createdAt        DateTime      @default(now())
  period           PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items            PayslipItem[]

  @@unique([periodId, employeeId])
}

model PayslipItem {
  id          String           @id @default(cuid())
  payslipId   String
  componentId String?
  name        String
  type        String // earning|deduction
  amount      Float
  note        String?
  source      String           @default("auto") // auto محسوب تلقائيًا | manual بند يدوي — يبقى بعد إعادة الحساب
  loanId      String? // قسط سلفة — يُرحَّل للقرض عند صرف الفترة
  editedBy    String? // من عدّل البند (للتدقيق)
  editedAt    DateTime?
  payslip     Payslip          @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  component   SalaryComponent? @relation(fields: [componentId], references: [id])
}

// إعدادات النظام (اسم الجهة، المعادلات، ADMS/BioTime) — key/value
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
